{% extends "base.html.j2" %}
{# Post-race hindsight: the optimal team this round, at each member's own
   budget, vs what members actually picked -- validation and chat content,
   not a prediction. #}

{% block content %}

{% if optimal_total is not none %}
<section class="tiles">
  <div class="tile good">
    <div class="tile-label">Optimal @ ${{ default_cap | int }}M (reference)</div>
    <div class="tile-value">{{ optimal_total }}</div>
    <div class="tile-name">captain: {{ optimal_captain }}</div>
    <div class="tile-note">{{ optimal_team | join(', ') }}</div>
  </div>
</section>
{% endif %}

{% if gaps %}
<section>
  <h2 class="section-title">Gap to optimal, at each team's own budget</h2>
  <div class="standings">
    {% for row in gaps %}
    <div class="budget-row">
      <div class="rank">{{ loop.index }}</div>
      <div class="who">
        <div class="who-name">{{ row.name }}</div>
        <div class="who-team">optimal @ {{ row.budget_cap_label }}: {{ row.optimal_at_budget if row.optimal_at_budget is not none else '–' }} pts</div>
      </div>
      <div class="bar-cell">
        <div class="bar-track">
          <div class="bar-fill" style="width: {{ row.bar_pct }}%"></div>
        </div>
        <div class="bar-value">{{ row.actual | points }}</div>
      </div>
      <div class="total delta {{ 'neg' if row.gap is not none and row.gap > 0 else 'pos' }}">
        {{ row.gap | signed if row.gap is not none else '–' }}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if closest or furthest %}
<section class="tiles">
  {% if closest %}
  <div class="tile good">
    <div class="tile-label">Closest to their own optimal</div>
    <div class="tile-value">{{ closest.actual }}</div>
    <div class="tile-name">{{ closest.name }}</div>
    <div class="tile-note">-{{ closest.gap }} off optimal @ {{ closest.budget_cap_label }}</div>
  </div>
  {% endif %}
  {% if furthest %}
  <div class="tile bad">
    <div class="tile-label">Furthest from their own optimal</div>
    <div class="tile-value">{{ furthest.actual }}</div>
    <div class="tile-name">{{ furthest.name }}</div>
    <div class="tile-note">-{{ furthest.gap }} off optimal @ {{ furthest.budget_cap_label }}</div>
  </div>
  {% endif %}
</section>
{% endif %}

{% if average_gap is not none %}
<div class="note">League average gap to (own-budget) optimal this round: {{ average_gap }} pts.</div>
{% endif %}

{% if ladder %}
<section>
  <h2 class="section-title">Optimal team by budget</h2>
  <div class="badges">
    {% for rung in ladder %}
    <span class="badge">{{ rung.budget_label }}: {{ rung.optimal_total if rung.optimal_total is not none else '–' }} pts</span>
    {% endfor %}
  </div>
  {% if ladder_note %}
  <div class="note">{{ ladder_note }}</div>
  {% endif %}
</section>
{% endif %}

{% if caveat %}
<div class="note">{{ caveat }}</div>
{% endif %}

{% endblock %}
